{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "description": "SportZone modular Express API",
  "dependencies": {
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/server.js",
    "start": "node dist/server.js",
    "lint": "biome lint src tests vitest.config.ts --error-on-warnings",
    "typecheck": "tsc --project tsconfig.check.json",
    "test:unit": "vitest run",
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --watch --project tsconfig.json",
    "test:smoke": "node tests/smoke.mjs"
  }
}
