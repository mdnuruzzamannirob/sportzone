{
  "name": "sportzone",
  "version": "0.0.0",
  "private": true,
  "description": "SportZone application workspace foundation",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "workspaces": [
    "storefront",
    "admin",
    "backend"
  ],
  "scripts": {
    "workspaces:check": "npm ls --workspaces --depth=0",
    "lint": "node scripts/check-repository.mjs",
    "test:unit": "node --test --test-isolation=none tests/ci.test.mjs tests/tooling.test.mjs",
    "ci": "node scripts/ci.mjs",
    "test:security": "node scripts/security.mjs",
    "test:ui": "tsc --project tests/ui/tsconfig.json && playwright test --config tests/ui/playwright.config.mts",
    "dev": "node scripts/dev.mjs",
    "ui:showcase": "node node_modules/vite/bin/vite.js --config tests/ui/vite.config.mts",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "format:check": "biome format scripts/dev.mjs scripts/dev-backend.mjs scripts/check-boundaries.mjs tests/tooling.test.mjs",
    "format": "biome format --write scripts/dev.mjs scripts/dev-backend.mjs scripts/check-boundaries.mjs tests/tooling.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3"
  }
}
