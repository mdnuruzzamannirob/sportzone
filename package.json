{
  "name": "sportzone",
  "version": "0.0.0",
  "private": true,
  "description": "SportZone application workspace foundation",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "workspaces": [
    "storefront",
    "admin",
    "backend"
  ],
  "scripts": {
    "workspaces:check": "npm ls --workspaces --depth=0",
    "lint": "node scripts/check-repository.mjs",
    "test:unit": "node --test --test-isolation=none tests/ci.test.mjs",
    "ci": "node scripts/ci.mjs",
    "test:security": "node scripts/security.mjs",
    "ci:workflow": "node scripts/ci-workflow.mjs",
    "test:ui": "tsc --project tests/ui/tsconfig.json && playwright test --config tests/ui/playwright.config.mts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}
