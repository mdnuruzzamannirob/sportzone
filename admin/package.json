{
  "name": "admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SportZone React and Vite administration portal",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "lint": "biome lint src tests vite.config.ts vitest.config.ts --error-on-warnings",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "@tailwindcss/vite": "4.3.3",
    "jsdom": "30.1.3"
  }
}
