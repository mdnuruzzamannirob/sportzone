{
  "name": "storefront",
  "version": "0.0.0",
  "private": true,
  "description": "SportZone Next.js App Router storefront",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "biome lint src tests scripts next.config.ts vitest.config.ts postcss.config.mjs --error-on-warnings",
    "typecheck": "node scripts/typecheck.mjs",
    "test:unit": "vitest run",
    "test:smoke": "node tests/smoke.mjs"
  },
  "type": "module",
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@tanstack/react-query": "5.105.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11.19.0 <12"
  }
}
