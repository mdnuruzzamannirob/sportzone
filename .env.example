# Configuration template — Operations Appendix B is authoritative.
# This file is not automatically loaded. Backend startup validates process
# configuration; local development may explicitly use Node --env-file=.env.
# Local origins below are development conventions, not deployed endpoints.
NODE_ENV=development
APP_ENV=local
RELEASE_ID=local-development
API_BIND_HOST=127.0.0.1
PORT=4000
API_PUBLIC_ORIGIN=http://localhost:4000
STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Backend only. Supply an isolated replica-set-capable MongoDB URI privately.
# Never point development or CI at production.
MONGODB_URI=
# Explicit isolated database name used by backend startup.
MONGODB_DB_NAME=sportzone_local
# Generate separate cryptographically random 32-byte lowercase hex values privately.
SESSION_SECRET=
# Enable customer auth only after explicit persistence bootstrap and policy configuration.
CUSTOMER_AUTH_ENABLED=false
HEALTH_MONITOR_TOKEN=

# Required by loadSessionOptions when identity session composition is activated.
# Positive bounded seconds require owner-approved values; no runtime fallback.
CUSTOMER_SESSION_TTL_SECONDS=
ADMIN_SESSION_TTL_SECONDS=
# Explicit same-site cookie policy: lax or strict; never none.
SESSION_COOKIE_SAME_SITE=
# Required by loadBrowserSecurityOptions at browser-security composition (1–1800 seconds).
BROWSER_CONTEXT_TTL_SECONDS=

# Proof delivery: encryption keys stay outside MongoDB and its backups.
# Versioned key-store references and CSRF/guest key names are finalized with
# their owning identity/guest implementation; no key material belongs here.
PROOF_DELIVERY_KEY_VERSION=

# Owner-approved bounded lifetimes; no guessed runtime fallback.
CHECKOUT_QUOTE_TTL_SECONDS=
MEDIA_TEMP_TTL_SECONDS=

# Server-only gateway configuration. A mode does not enable a merchant/channel.
# Exact credential, refund/status and callback keys follow the verified adapter.
SSLCOMMERZ_MODE=sandbox

# Email, Cloudinary, refund calendar, workers, monitoring and backup keys are
# added with their actual adapters/config validators and protected inventory.
# Do not paste credentials into NEXT_PUBLIC_* or VITE_* browser configuration.

# Separate one-batch notification worker; HTTP registration does not activate email.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=resend
# live only in production; all other environments require test and an approved test inbox.
EMAIL_MODE=test
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=
EMAIL_TIMEOUT_MS=
EMAIL_MAX_ATTEMPTS=
EMAIL_RETRY_BASE_MS=
EMAIL_RETRY_MAX_MS=
EMAIL_CLAIM_TTL_MS=
EMAIL_BATCH_SIZE=
