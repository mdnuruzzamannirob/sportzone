# SportZone — Local development configuration template
# Illustrative values only. Replace <placeholders>, domains and policy paths before enabling features.
# Example policy files do not exist automatically; limits/consent types require your review.

# Runtime
# Local development. Hosted environments need their own reviewed configuration.
NODE_ENV=development
APP_ENV=local
RELEASE_ID=local-development
API_BIND_HOST=127.0.0.1
PORT=4000

# Application origins
# Exact origins only; no paths. Keep CORS aligned with both clients.
API_PUBLIC_ORIGIN=http://localhost:4000
STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
# Requires a running MongoDB replica set. db:local prints an ephemeral URI to use here.
MONGODB_URI=mongodb://127.0.0.1:27017/sportzone_local?replicaSet=rs0
MONGODB_DB_NAME=sportzone_local

# Security keys
# Private independent keys. Proof keys are a JSON version-to-32-byte-hex map; retain existing versions.
SESSION_SECRET=<generate-independent-64-character-hex>
HEALTH_MONITOR_TOKEN=<generate-another-64-character-hex>
AUTH_PROOF_ACTIVE_KEY_VERSION=local
AUTH_PROOF_KEYS_JSON='{"local":"<generate-independent-64-character-hex>"}'

# Authentication and sessions
# Feature switches stay explicit. Durations below are local development values in seconds.
CUSTOMER_AUTH_ENABLED=false
ADMIN_AUTH_ENABLED=false
CUSTOMER_SESSION_TTL_SECONDS=3600
ADMIN_SESSION_TTL_SECONDS=1800
SESSION_COOKIE_SAME_SITE=lax
BROWSER_CONTEXT_TTL_SECONDS=300

# Password recovery
# Proof flows require HTTPS origins, identity persistence and configured delivery. Response floors use milliseconds.
PASSWORD_RECOVERY_ENABLED=false
PASSWORD_RESET_TTL_SECONDS=600
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_RESPONSE_FLOOR_MS=100
ADMIN_PASSWORD_RESET_TTL_SECONDS=600
ADMIN_PASSWORD_RESET_COOLDOWN_SECONDS=60
ADMIN_PASSWORD_RESET_RESPONSE_FLOOR_MS=100

# Email verification and changes
# Lifetimes/cooldowns use seconds; response floors use milliseconds.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RESPONSE_FLOOR_MS=100
EMAIL_CHANGE_ENABLED=false
EMAIL_CHANGE_TTL_SECONDS=600
EMAIL_CHANGE_COOLDOWN_SECONDS=60
EMAIL_CHANGE_RESPONSE_FLOOR_MS=100

# Guest order access
# Requires customer auth and HTTPS storefront. No access is granted by an order ID alone.
GUEST_ACCESS_ENABLED=false
GUEST_ORDER_ACCESS_TTL_SECONDS=600
GUEST_ORDER_ACCESS_COOLDOWN_SECONDS=60
GUEST_ORDER_ACCESS_RESPONSE_FLOOR_MS=100
GUEST_ORDER_SESSION_TTL_SECONDS=3600

# Store policies and checkout
# Business thresholds, required policy types and approval files remain explicit before activation.
STORE_INITIAL_LOW_STOCK_THRESHOLD=5
POLICY_APPROVALS_FILE=.cache/local/policy-approvals.json
DELIVERY_DEADLINE_POLICY_FILE=.cache/local/delivery-deadline-policy.json
CHECKOUT_QUOTES_ENABLED=false
CHECKOUT_QUOTE_TTL_SECONDS=900
CHECKOUT_REQUIRED_POLICY_TYPES=terms,privacy
CHECKOUT_COD_ENABLED=false
CUSTOMER_ORDER_READ_ENABLED=false

# Orders and delivery
# Protected policy/evidence files are operator inputs; do not fabricate approval or collection evidence.
ORDER_OPERATIONS_ENABLED=false
COD_COLLECTION_EVIDENCE_FILE=.cache/local/cod-evidence.json
CANCELLATION_REFUND_AUTHORIZATIONS_FILE=.cache/local/cancellation-refunds.json
DELIVERY_DISPOSITION_FILE=.cache/local/delivery-dispositions.json
ORDER_NOTIFICATIONS_ENABLED=false

# Returns and refunds
# Local/test admission only; payout evidence and policy are separate from activation.
RETURN_OPERATIONS_ENABLED=false
RETURN_POLICY_FILE=.cache/local/return-policy.json
REFUND_OPERATIONS_ENABLED=false
REFUND_POLICY_FILE=.cache/local/refund-policy.json
REFUND_PAYOUT_EVIDENCE_FILE=.cache/local/refund-evidence.json
AFTER_SALES_HISTORY_ENABLED=false
AFTER_SALES_NOTIFICATIONS_ENABLED=false

# SSLCOMMERZ provider
# Private merchant credentials and independent channel approval required; callback origin must be HTTPS.
SSLCOMMERZ_ADAPTER_ENABLED=false
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=<sandbox-store-id>
SSLCOMMERZ_STORE_PASSWORD=<sandbox-store-password>
SSLCOMMERZ_CALLBACK_ORIGIN=https://api.example.test
SSLCOMMERZ_TIMEOUT_MS=15000
PAYMENT_CHANNEL_APPROVALS_FILE=.cache/local/payment-channel-approvals.json

# Payment processing
# Return URLs must match the HTTPS storefront. Rate limit is requests per minute.
PAYMENT_INITIATION_ENABLED=false
PAYMENT_CALLBACKS_ENABLED=false
PAYMENT_PROCESSING_ENABLED=false
PAYMENT_RETURN_SUCCESS_URL=https://shop.example.test/payment/success
PAYMENT_RETURN_FAIL_URL=https://shop.example.test/payment/fail
PAYMENT_RETURN_CANCEL_URL=https://shop.example.test/payment/cancel
PAYMENT_CALLBACK_RATE_LIMIT=60
PAYMENT_MATCHING_EVIDENCE_FILE=.cache/local/payment-matching-evidence.json
PAYMENT_NOTIFICATIONS_ENABLED=false

# Reconciliation workers
# Separate scheduled runners; intervals and leases use milliseconds.
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_BATCH_SIZE=20
PAYMENT_RECONCILIATION_LEASE_MS=60000
PAYMENT_RECONCILIATION_POLL_MS=60000
PAYMENT_RECONCILIATION_TERMINAL_POLL_MS=300000
PAYMENT_RECONCILIATION_ESCALATE_AFTER_MS=3600000
REFUND_RECONCILIATION_ENABLED=false
REFUND_RECONCILIATION_BATCH_SIZE=20
REFUND_RECONCILIATION_LEASE_MS=60000
REFUND_RECONCILIATION_POLL_MS=60000

# Email provider
# Use a verified sender email address. Test mode requires an explicitly approved test recipient.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_MODE=test
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=noreply@example.test
EMAIL_TEST_RECIPIENT=developer@example.test

# Email worker
# HTTP startup does not start this worker. Timeout/backoff/lease values use milliseconds.
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=1000
EMAIL_RETRY_MAX_MS=60000
EMAIL_CLAIM_TTL_MS=60000
EMAIL_BATCH_SIZE=10

# Media provider and policy
# Approve retention and JSON maxBytes/maxPixels/allowedFormats/privateUrlTtlSeconds before enabling uploads.
MEDIA_ENABLED=false
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
MEDIA_PROVIDER_TIMEOUT_MS=15000
MEDIA_TEMP_TTL_SECONDS=86400
MEDIA_POLICY_JSON='{"maxBytes":5242880,"maxPixels":40000000,"allowedFormats":["jpg","png","webp"],"privateUrlTtlSeconds":120}'

# Private media scanner
# Host must point to a running private scanner; credentials alone do not enable uploads.
MEDIA_SCANNER=clamav
MEDIA_SCANNER_HOST=127.0.0.1
MEDIA_SCANNER_PORT=3310
MEDIA_SCANNER_TIMEOUT_MS=15000

# Maintenance workers
# Separate scheduled runners; batch sizes count records and leases use milliseconds.
RESERVATION_EXPIRY_BATCH_SIZE=50
RESERVATION_EXPIRY_LEASE_MS=60000
MEDIA_MAINTENANCE_ENABLED=false
MEDIA_MAINTENANCE_BATCH_SIZE=20
MEDIA_MAINTENANCE_LEASE_MS=60000

# Backend operations
# Explicit local/test support, privacy, reporting and exception operations.
BACKEND_OPERATIONS_ENABLED=false

# Frontend reference values
# Reference only: clients read their own app-local .env.local files, not this backend file.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
VITE_API_ORIGIN=http://localhost:4000
