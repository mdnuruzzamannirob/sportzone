# Configuration template — Operations Appendix B is authoritative.
# This template is not loaded. Root npm run dev loads an optional private .env
# for the API only; direct startup needs injected variables or Node --env-file=.env.
# Local origins below are development conventions, not deployed endpoints.
NODE_ENV=development
APP_ENV=local
RELEASE_ID=local-development
API_BIND_HOST=127.0.0.1
PORT=4000
API_PUBLIC_ORIGIN=http://localhost:4000
STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Backend only. Supply an isolated replica-set-capable MongoDB URI privately.
# Never point development or CI at production.
MONGODB_URI=
# Explicit isolated database name used by backend startup.
MONGODB_DB_NAME=sportzone_local
# Generate separate cryptographically random 32-byte lowercase hex values privately.
SESSION_SECRET=
# Enable customer auth only after explicit persistence bootstrap and policy configuration.
CUSTOMER_AUTH_ENABLED=false
# Independent administrator credentials; requires explicit session/context and admin reset policy.
ADMIN_AUTH_ENABLED=false
HEALTH_MONITOR_TOKEN=

# Required by loadSessionOptions when identity session composition is activated.
# Positive bounded seconds require owner-approved values; no runtime fallback.
CUSTOMER_SESSION_TTL_SECONDS=
ADMIN_SESSION_TTL_SECONDS=
# Explicit same-site cookie policy: lax or strict; never none.
SESSION_COOKIE_SAME_SITE=
# Required by loadBrowserSecurityOptions at browser-security composition (1–1800 seconds).
BROWSER_CONTEXT_TTL_SECONDS=

# Proof delivery: encryption keys stay outside MongoDB and its backups.
# Inject a private JSON object of version -> random 32-byte lowercase hex key.
# Retain needed previous versions; never reuse session/monitor keys.
PASSWORD_RECOVERY_ENABLED=false
AUTH_PROOF_ACTIVE_KEY_VERSION=
AUTH_PROOF_KEYS_JSON=
# Required on activation: TTL 60–1800s, cooldown 60–3600s, response floor 100–5000ms.
# Recovery requires an approved HTTPS STOREFRONT_ORIGIN, including in local/test.
PASSWORD_RESET_TTL_SECONDS=
PASSWORD_RESET_COOLDOWN_SECONDS=
PASSWORD_RESET_RESPONSE_FLOOR_MS=
# Independent customer email-change activation; shares protected proof keys/HTTPS origin.
EMAIL_CHANGE_ENABLED=false
EMAIL_CHANGE_TTL_SECONDS=
EMAIL_CHANGE_COOLDOWN_SECONDS=
EMAIL_CHANGE_RESPONSE_FLOOR_MS=
# Fixed HTTPS ADMIN_ORIGIN and shared protected proof keys; same bounds as customer reset.
ADMIN_PASSWORD_RESET_TTL_SECONDS=
ADMIN_PASSWORD_RESET_COOLDOWN_SECONDS=
ADMIN_PASSWORD_RESET_RESPONSE_FLOOR_MS=

# Owner-approved bounded lifetimes; no guessed runtime fallback.
CHECKOUT_QUOTE_TTL_SECONDS=
MEDIA_TEMP_TTL_SECONDS=

# Server-only gateway configuration. A mode does not enable a merchant/channel.
# Private adapter configuration; not wired to HTTP or merchant/channel activation.
SSLCOMMERZ_ADAPTER_ENABLED=false
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Absolute HTTPS API origin without trailing slash/path/query; fixed callbacks are derived.
SSLCOMMERZ_CALLBACK_ORIGIN=
SSLCOMMERZ_TIMEOUT_MS=
# Operator-controlled approval manifest + digest-matched evidence files. Absent means no online channels.
PAYMENT_CHANNEL_APPROVALS_FILE=
# Local/test only; staging/live remain blocked pending callback/verification qualification.
PAYMENT_INITIATION_ENABLED=false
# Local/test callback transport only. IPN remains 503 until independent processing is composed.
PAYMENT_CALLBACKS_ENABLED=false
# Local/test only, requires callbacks + sandbox adapter; offset-free provider dates remain retryable.
PAYMENT_PROCESSING_ENABLED=false
# Absolute HTTPS URLs on STOREFRONT_ORIGIN; fixed paths, no query/fragment/credentials.
PAYMENT_RETURN_SUCCESS_URL=
PAYMENT_RETURN_FAIL_URL=
PAYMENT_RETURN_CANCEL_URL=
# Explicit requests per peer per minute, 1..60; existing protected quota store is required.
PAYMENT_CALLBACK_RATE_LIMIT=

# Email, Cloudinary, refund calendar, workers, monitoring and backup keys are
# added with their actual adapters/config validators and protected inventory.
# Do not paste credentials into NEXT_PUBLIC_* or VITE_* browser configuration.

# Separate one-batch notification worker; HTTP registration does not activate email.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=resend
# live only in production; all other environments require test and an approved test inbox.
EMAIL_MODE=test
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=
EMAIL_TIMEOUT_MS=
EMAIL_MAX_ATTEMPTS=
EMAIL_RETRY_BASE_MS=
EMAIL_RETRY_MAX_MS=
EMAIL_CLAIM_TTL_MS=
EMAIL_BATCH_SIZE=

# Public frontend build configuration (set in each frontend process/.env.local).
# Only the API origin is public; never copy backend secrets into frontend env files.
# Server-rendered catalog also needs API_PUBLIC_ORIGIN/STOREFRONT_ORIGIN in the storefront runtime.
# Reuse the origin values above; no backend secrets belong in frontend configuration.
NEXT_PUBLIC_API_ORIGIN=
VITE_API_ORIGIN=


# Media adapters: no approved account/policy is implied by these empty fields.
# Explicit composition with scanner/retention capabilities is required; not auto-enabled by HTTP startup.
MEDIA_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_PROVIDER_TIMEOUT_MS=
# JSON: maxBytes, maxPixels, allowedFormats (png/jpg/webp), privateUrlTtlSeconds.
# Temporary lifetime uses MEDIA_TEMP_TTL_SECONDS above; no runtime fallback.
MEDIA_POLICY_JSON=
MEDIA_SCANNER=clamav
MEDIA_SCANNER_HOST=
MEDIA_SCANNER_PORT=
MEDIA_SCANNER_TIMEOUT_MS=

# Explicit operator/test-approved settings bootstrap threshold; no runtime default.
STORE_INITIAL_LOW_STOCK_THRESHOLD=
# Optional protected read-only policy approval register path; never browser-controlled.
POLICY_APPROVALS_FILE=

# Optional protected delivery deadline manifest for technical preflight; real review is required.
DELIVERY_DEADLINE_POLICY_FILE=

# Checkout quotes are opt-in; lifetime/applicable policy values require operator configuration.
CHECKOUT_QUOTES_ENABLED=false
CHECKOUT_QUOTE_TTL_SECONDS=
CHECKOUT_REQUIRED_POLICY_TYPES=

# COD submission requires checkout quotes, reviewed policy and provisioned checkout persistence.
CHECKOUT_COD_ENABLED=false

# Explicit scheduled one-shot expiry worker settings; no business history uses TTL.
RESERVATION_EXPIRY_BATCH_SIZE=
RESERVATION_EXPIRY_LEASE_MS=
# Guest proof requires customer auth, HTTPS storefront and AUTH_PROOF_* key custody.
GUEST_ACCESS_ENABLED=false
GUEST_ORDER_ACCESS_TTL_SECONDS=
GUEST_ORDER_ACCESS_COOLDOWN_SECONDS=
GUEST_ORDER_ACCESS_RESPONSE_FLOOR_MS=
GUEST_ORDER_SESSION_TTL_SECONDS=

# Explicit local/test one-shot payment reconciliation; schedule via an owned runner, not API startup.
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_BATCH_SIZE=
PAYMENT_RECONCILIATION_LEASE_MS=
PAYMENT_RECONCILIATION_POLL_MS=
PAYMENT_RECONCILIATION_TERMINAL_POLL_MS=
PAYMENT_RECONCILIATION_ESCALATE_AFTER_MS=
