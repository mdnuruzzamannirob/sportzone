# SportZone | Staging example. Replace example origins and supply credentials privately.
# Review technical examples before enabling any feature. Never commit private env files.

# 01 | Runtime
# Use production/staging for hosted staging; bind hosted API to 0.0.0.0.
NODE_ENV=production
APP_ENV=staging
# Use an identifier for the deployed revision.
RELEASE_ID=
API_BIND_HOST=0.0.0.0
PORT=4000

# 02 | Application origins
# Use exact origins without paths or trailing slashes. CORS lists storefront and admin.
API_PUBLIC_ORIGIN=https://api.example.com
STOREFRONT_ORIGIN=https://shop.example.com
ADMIN_ORIGIN=https://admin.example.com
CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com

# 03 | Database
# Use an isolated replica-set-capable database; never use production data for development.
# Required database connection URI; store it privately.
MONGODB_URI=
MONGODB_DB_NAME=sportzone_staging

# 04 | Security keys
# Keep keys private and independent. Retain proof-key versions needed for recovery.
SESSION_SECRET=
HEALTH_MONITOR_TOKEN=
AUTH_PROOF_ACTIVE_KEY_VERSION=
# JSON map of key version to independent 32-byte lowercase hex key.
AUTH_PROOF_KEYS_JSON=

# 05 | Authentication and browser sessions
# Authentication requires approved session settings and persistence bootstrap.
CUSTOMER_AUTH_ENABLED=false
ADMIN_AUTH_ENABLED=false
CUSTOMER_SESSION_TTL_SECONDS=
ADMIN_SESSION_TTL_SECONDS=
SESSION_COOKIE_SAME_SITE=lax
BROWSER_CONTEXT_TTL_SECONDS=

# 06 | Password recovery
# Recovery requires authentication, proof keys, HTTPS origins, and delivery configuration.
PASSWORD_RECOVERY_ENABLED=false
PASSWORD_RESET_TTL_SECONDS=
PASSWORD_RESET_COOLDOWN_SECONDS=
PASSWORD_RESET_RESPONSE_FLOOR_MS=
ADMIN_PASSWORD_RESET_TTL_SECONDS=
ADMIN_PASSWORD_RESET_COOLDOWN_SECONDS=
ADMIN_PASSWORD_RESET_RESPONSE_FLOOR_MS=

# 07 | Customer email changes
# Email change requires authentication, proof keys, HTTPS, and explicit policy.
EMAIL_CHANGE_ENABLED=false
EMAIL_CHANGE_TTL_SECONDS=
EMAIL_CHANGE_COOLDOWN_SECONDS=
EMAIL_CHANGE_RESPONSE_FLOOR_MS=

# 08 | Guest order access
# Guest access requires customer authentication and an HTTPS storefront.
GUEST_ACCESS_ENABLED=false
GUEST_ORDER_ACCESS_TTL_SECONDS=
GUEST_ORDER_ACCESS_COOLDOWN_SECONDS=
GUEST_ORDER_ACCESS_RESPONSE_FLOOR_MS=
GUEST_ORDER_SESSION_TTL_SECONDS=

# 09 | Store policies and checkout
# Policy references and business thresholds require owner approval; no default is assumed.
STORE_INITIAL_LOW_STOCK_THRESHOLD=
POLICY_APPROVALS_FILE=
DELIVERY_DEADLINE_POLICY_FILE=
CHECKOUT_QUOTES_ENABLED=false
# Checkout and media lifetimes require owner-approved values.
CHECKOUT_QUOTE_TTL_SECONDS=
CHECKOUT_REQUIRED_POLICY_TYPES=
CHECKOUT_COD_ENABLED=false
CUSTOMER_ORDER_READ_ENABLED=false

# 10 | SSLCOMMERZ sandbox adapter
# Credentials and channel approval are separate. Callback origin must be HTTPS.
SSLCOMMERZ_ADAPTER_ENABLED=false
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Enter the API HTTPS origin only; callback paths are derived.
SSLCOMMERZ_CALLBACK_ORIGIN=https://api.example.com
SSLCOMMERZ_TIMEOUT_MS=15000
PAYMENT_CHANNEL_APPROVALS_FILE=

# 11 | Payment transport and processing
# Payment initiation, callbacks, and processing are currently limited to local/test.
PAYMENT_INITIATION_ENABLED=false
PAYMENT_CALLBACKS_ENABLED=false
PAYMENT_PROCESSING_ENABLED=false
# Return URLs must use the storefront HTTPS origin.
PAYMENT_RETURN_SUCCESS_URL=
PAYMENT_RETURN_FAIL_URL=
PAYMENT_RETURN_CANCEL_URL=
PAYMENT_CALLBACK_RATE_LIMIT=

# 12 | Email provider
# Use a verified sender, or the provider test sender with an approved test inbox.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_MODE=test
RESEND_API_KEY=
# Plain sender email address only; do not include a display name.
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=

# 13 | Email delivery worker
# One-shot worker settings; HTTP startup does not start a notification worker.
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=1000
EMAIL_RETRY_MAX_MS=60000
EMAIL_CLAIM_TTL_MS=60000
EMAIL_BATCH_SIZE=10
PAYMENT_NOTIFICATIONS_ENABLED=false
ORDER_NOTIFICATIONS_ENABLED=false

# 14 | Cloudinary media provider
# Cloudinary credentials alone do not enable media uploads.
MEDIA_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_PROVIDER_TIMEOUT_MS=15000

# 15 | Media policy and private scanner
# Media policy and a reachable private scanner are required before media activation.
# Temporary media lifetime requires an approved retention policy.
MEDIA_TEMP_TTL_SECONDS=
# JSON fields: maxBytes, maxPixels, allowedFormats, privateUrlTtlSeconds.
MEDIA_POLICY_JSON=
MEDIA_SCANNER=clamav
# Private scanner host must point to an actual running scanner.
MEDIA_SCANNER_HOST=
MEDIA_SCANNER_PORT=3310
MEDIA_SCANNER_TIMEOUT_MS=15000

# 16 | Reservation expiry worker
# The expiry worker runs separately; configure an authorized scheduler.
RESERVATION_EXPIRY_BATCH_SIZE=50
RESERVATION_EXPIRY_LEASE_MS=60000

# 17 | Payment reconciliation worker
# Reconciliation is currently local/test only and requires a separate runner.
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_BATCH_SIZE=20
PAYMENT_RECONCILIATION_LEASE_MS=60000
PAYMENT_RECONCILIATION_POLL_MS=60000
PAYMENT_RECONCILIATION_TERMINAL_POLL_MS=300000
PAYMENT_RECONCILIATION_ESCALATE_AFTER_MS=3600000

# 18 | Public frontend configuration
# Frontend apps read their own environment. Never put backend secrets in frontend files.
NEXT_PUBLIC_API_ORIGIN=https://api.example.com
VITE_API_ORIGIN=https://api.example.com
